{
  "$schema": "../../umbraco-package-schema.json",
  "name": "ReadingRoom.Umbraco.CloudflareStream",
  "version": "0.1.0",
  "extensions": [
    {
      "type": "propertyEditorUi",
      "alias": "ReadingRoom.Umbraco.CloudflareStream.Ui",
      "name": "RR CloudflareStream Property Editor UI",
      "element": "/App_Plugins/ReadingRoom.Umbraco.CloudflareStream/index.js",
      "elementName": "cf-stream-editor",
      "meta": {
        "label": "Cloudflare Stream Media",
        "icon": "icon-video",
        "group": "common",
        "propertyEditorSchemaAlias": "CloudflareStreamMedia"
      }
    },
    {
      "type": "workspaceAction",
      "kind": "default",
      "alias": "ReadingRoom.WorkspaceAction.Media.CfStream.Save",
      "name": "CF Stream Media Save Action",
      "api": "/App_Plugins/ReadingRoom.Umbraco.CloudflareStream/save-action.js",
      "overwrites": "Umb.WorkspaceAction.Media.Save",
      "meta": {
        "label": "#buttons_save",
        "look": "primary",
        "color": "positive"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.WorkspaceAlias",
          "match": "Umb.Workspace.Media"
        }
      ]
    }
  ]
}