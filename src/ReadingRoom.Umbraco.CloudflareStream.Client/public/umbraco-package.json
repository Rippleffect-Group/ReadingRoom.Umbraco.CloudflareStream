{
  "$schema": "../../ReadingRoom.Umbraco.CloudflareStream.TestSite/umbraco-package-schema.json",
  "name": "ReadingRoom.Umbraco.CloudflareStream",
  "version": "1.0.0",
  "extensions": [
    {
      "type": "propertyEditorUi",
      "alias": "ReadingRoom.Umbraco.CloudflareStream.Ui",
      "name": "RR CloudflareStream Property Editor UI",
      "element": "/App_Plugins/ReadingRoom.Umbraco.CloudflareStream/index.js",
      "elementName": "cf-stream-editor",
      "meta": {
        "label": "Cloudflare Stream Media",
        "icon": "icon-video",
        "group": "common",
        "propertyEditorSchemaAlias": "CloudflareStreamMedia",
        "settings": {
          "properties": [
            {
              "alias": "requiresignedurls",
              "label": "Require Signed URLs",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Toggle"
            },
            {
              "alias": "expiry",
              "label": "Expiry",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Integer"
            },
            {
              "alias": "deleteAfter",
              "label": "Delete After",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Integer"
            }
          ],
          "defaultData": [
            { "alias": "requiresignedurls", "value": false },
            { "alias": "deleteAfter", "value": 30 }
          ]
        }
      }
    },
    {
      "type": "propertyEditorUi",
      "alias": "Cloudflare.Stream.MediaPicker.UI",
      "name": "Cloudflare Stream Media Picker",
      "element": "/App_Plugins/ReadingRoom.Umbraco.CloudflareStream/media-picker.js",
      "elementName": "cf-stream-media-picker",
      "meta": {
        "label": "Cloudflare Stream Media Picker",
        "icon": "icon-video",
        "group": "media",
        "propertyEditorSchemaAlias": "CloudflareStreamMediaPicker",
        "supportsReadOnly": true,
        "settings": {
          "properties": [
            {
              "alias": "multiple",
              "label": "Pick multiple items",
              "description": "Allows the editor to pick multiple media items.",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Toggle"
            },
            {
              "alias": "validationLimit",
              "label": "Amount",
              "description": "Set a required range of media items.",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.NumberRange"
            },
            {
              "alias": "enableLocalFocalPoint",
              "label": "Enable focal point",
              "description": "Enable the focal point feature for images.",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Toggle"
            },
            {
              "alias": "filter",
              "label": "Accepted types",
              "description": "Limit to specific media types.",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.MediaTypePicker"
            }
          ],
          "defaultData": [
            { "alias": "multiple", "value": false },
            { "alias": "enableLocalFocalPoint", "value": false }
          ]
        }
      }
    },
    {
      "type": "workspaceAction",
      "kind": "default",
      "alias": "ReadingRoom.WorkspaceAction.Media.CfStream.Save",
      "name": "CF Stream Media Save Action",
      "api": "/App_Plugins/ReadingRoom.Umbraco.CloudflareStream/save-action.js",
      "overwrites": "Umb.WorkspaceAction.Media.Save",
      "meta": {
        "label": "#buttons_save",
        "look": "primary",
        "color": "positive"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.WorkspaceAlias",
          "match": "Umb.Workspace.Media"
        }
      ]
    }
  ]
}